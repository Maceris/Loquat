flat int;
flat Float;
flat bool;
flat BxDF;
flat Medium;
flat LayeredBxDFConfig;

soa SampledSpectrum;
soa SampledWavelengths;

soa Interval {
    Float low, high;
};

soa Point2f { Float x, y; };
soa Point2i { int x, y; };
soa Point3f { Float x, y, z; };
soa Vec3f { Float x, y, z; };
soa Normal3f { Float x, y, z; };
soa Point3fi { Interval x, y, z; };

soa Ray {
    Point3f origin;
    Vec3f direction;
    Float time;
    Medium medium;
};

soa SubsurfaceInteraction {
    Point3fi pi;
    Normal3f normal;
    Vec3f dpdu;
    Vec3f dpdv;
    Normal3f shading_normal;
    Vec3f dpdus;
    Vec3f dpdvs;
};

soa Frame {
    Vec3f x, y, z;
};

soa VisibleSurface {
    bool set;
    Point3f p;
    Normal3f normal;
    Normal3f shading_normal;
    Point2f uv;
    Float time;
    Vec3f dpdx;
    Vec3f dpdy;
    SampledSpectrum albedo;
};

soa MediumInterface {
    Medium inside;
    Medium outside;
};

soa TabulatedBSSRDF {
    Point3f po;
    Vec3f outgoing;
    Normal3f shading_normal;
    Float eta;
    const BSSRDFTable *table;
    SampledSpectrum sigma_t;
    SampledSpectrum rho;
};

soa LightSampleContext {
    Point3fi pi;
    Normal3f normal;
    Normal3f shading_normal;
};